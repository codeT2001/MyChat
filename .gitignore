dist/

# ===== 运行期产物 / 日志 / 临时文件 =====
logs/
*.log
tmp/
temp/
*.tmp
*.temp

# ===== 真实配置与凭据（仓库只保留 *.example 模板）=====
config.ini
config2.ini
config.json
.env
.env.local
.env.*.local
*.key
*.pem
*.p12

# ===== 测试与覆盖率 =====
coverage/
.nyc_output/
test-results/
junit.xml

# ===== 其他 =====
*.pyc
core
!core/
