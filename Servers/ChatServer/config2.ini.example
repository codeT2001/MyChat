# ChatServer 实例 2 配置模板
# 用法：cp config2.ini.example config2.ini，填入本机真实值。
# config2.ini 已被 .gitignore 忽略（不入库），可以直接写明文口令；
# 本模板入库，只能放假值，禁止填真实凭据。

[GateServer]
Port = 9090

[VerifyServer]
Host = 127.0.0.1
Port = 50051

[StatusServer]
Host = 127.0.0.1
Port = 50052

[Redis]
Host = 127.0.0.1
Port = 6379
BlockingSocketTimeoutMs = 5000

[MySQL]
Host = 127.0.0.1
Port = 3306
User = your_mysql_user
Pwd = your_mysql_password
Schema = chat_db
PoolMaxSize = 5

[SelfServer]
Name = ChatServer2
Host = 127.0.0.1
RpcHost = 127.0.0.1
PublicHost = 127.0.0.1
Port = 50062
RPCPort = 50082

[Cluster]
NodeTTLSeconds = 30
HeartbeatSeconds = 10
NotifyTransport = stream
StreamMaxLen = 100000
StreamKeyTtlSeconds = 86400
StreamBatchSize = 64
StreamBlockMs = 1000
StreamReclaimIntervalSeconds = 30
StreamPendingMinIdleSeconds = 60
StreamMaxDeliveryAttempts = 5
StreamMaxEventAgeSeconds = 300
DedupTtlSeconds = 600

[Business]
WorkerThreads = 4
MaxPendingPerWorker = 4096

[RPC]
DeadlineMs = 500
PoolSize = 5
AcquireTimeoutMs = 1000
WorkerThreads = 2
MaxPendingPerWorker = 4096
