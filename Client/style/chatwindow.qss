/* ========== ChatWindow 主窗口 ========== */
#ChatWindow {
    background-color: #e5e7eb;
}

/* ========== 侧边栏 ========== */
#sideBar {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
    stop:0 #1e293b, stop:1 #0f172a);
}

#sideChatBtn {
    border-image: url(:/images/chat_icon.png);
}

#sideChatBtn:hover {
    border-image: url(:/images/chat_icon_hover.png);
}

#sideChatBtn:pressed {
    border-image: url(:/images/chat_icon_press.png);
}

#sideChatBtn:checked {
    border-image: url(:/images/chat_icon_press.png);
}

#sideContBtn {
    border-image: url(:/images/contact_list.png);
}

#sideContBtn:hover {
    border-image: url(:/images/contact_list_hover.png);
}

#sideContBtn:pressed {
    border-image: url(:/images/contact_list_press.png);
}

#sideContBtn:checked {
    border-image: url(:/images/contact_list_press.png);
}

/* ========== 搜索区域 ========== */
#searchWidget {
    background-color: #ffffff;
    border-bottom: 1px solid #e2e8f0;
    border-radius: 0 0 12px 12px;
}

#searchEdit {
    background-color: #f1f5f9;
    border: none;
    border-radius: 18px;
    padding: 0 16px;
    color: #1e293b;
    font-size: 14px;
}

#searchEdit:focus {
    background-color: #ffffff;
    border: 2px solid #3b82f6;
}

#searchEdit::placeholder {
    color: #94a3b8;
}

#addBtn {
    border-image: url(:/images/add_friend_normal.png);
}

#addBtn:hover {
    border-image: url(:/images/add_friend_hover.png);
}

#addBtn:pressed {
    border-image: url(:/images/add_friend.png);
}

/* ========== 用户列表 ========== */
#chatUserWidget {
    background-color: #f8fafc;
    border-right: 1px solid #e2e8f0;
}

#usersList {
    background-color: #f8fafc;
    border: none;
}

#usersList::item {
    background-color: transparent;
    border: none;
    outline: none;
    padding: 0px;
    margin: 0px;
}

#usersList::item:selected {
    background-color: #eff6ff;
    border: none;
    outline: none;
}

#usersList::item:hover {
    background-color: #f1f5f9;
    border: none;
    outline: none;
}

#searchList {
    background-color: rgb(247,247,248);
    border: none;
    outline: none;
    padding: 0px;
    margin: 0px;
}

#searchList::item:selected {
    background-color: #d3d7d4;
    border: none;
    outline: none;
}

#searchList::item:hover {
    background-color: rgb(206,207,208);
    border: none;
    outline: none;
}

#searchList::focus {
    border: none;
    outline: none;
}

#contactsList {
    background-color: #f8fafc;
    border: none;
}

#contactsList::item {
    background-color: transparent;
    border: none;
    outline: none;
    padding: 0px;
    margin: 0px;
    border-radius: 6px;
}

#contactsList::item:hover {
    background-color: #e2e8f0;
}

#contactsList::item:selected {
    background-color: #eff6ff;
    color: #1e293b;
}

/* ========== 聊天数据区容器 ========== */
#chatDataStackWidget {
    background-color: #ffffff;
    border-left: 1px solid #e2e8f0;
}
