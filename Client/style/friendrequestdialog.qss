/* ========== FriendRequestDialog 好友申请/认证弹窗 ========== */
#FriendRequestDialog {
    background-color: #ffffff;
    border: 1px solid #e2e8f0;
    border-radius: 12px;
}

#FriendRequestDialog #titleLabel {
    color: #1e293b;
    font: bold 16px "Microsoft YaHei";
}

#FriendRequestDialog QLabel {
    color: #475569;
    font: 13px "Microsoft YaHei";
}

#FriendRequestDialog QLineEdit {
    background-color: #f8fafc;
    border: 1px solid #e2e8f0;
    border-radius: 6px;
    padding: 4px 10px;
    color: #1e293b;
    font: 13px "Microsoft YaHei";
}

#FriendRequestDialog QLineEdit:focus {
    background-color: #ffffff;
    border: 1px solid #3b82f6;
}

#FriendRequestDialog QGroupBox {
    color: #475569;
    font: 13px "Microsoft YaHei";
    border: 1px solid #e2e8f0;
    border-radius: 8px;
    margin-top: 14px;
    padding: 4px 8px 8px 8px;
}

#FriendRequestDialog QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    left: 12px;
    top: 4px;
    padding: 0 4px;
    background-color: #ffffff;
}

#FriendRequestDialog QPushButton#sureBtn {
    background-color: #3b82f6;
    color: white;
    border: none;
    border-radius: 6px;
    font: bold 14px "Microsoft YaHei";
}

#FriendRequestDialog QPushButton#sureBtn:hover {
    background-color: #2563eb;
}

#FriendRequestDialog QPushButton#sureBtn:pressed {
    background-color: #1d4ed8;
}

#FriendRequestDialog QPushButton#cancelBtn {
    background-color: #ffffff;
    color: #475569;
    border: 1px solid #cbd5e1;
    border-radius: 6px;
    font: 13px "Microsoft YaHei";
}

#FriendRequestDialog QPushButton#cancelBtn:hover {
    color: #1e293b;
    border-color: #94a3b8;
    background-color: #f8fafc;
}

#FriendRequestDialog QPushButton#cancelBtn:pressed {
    background-color: #e2e8f0;
}
