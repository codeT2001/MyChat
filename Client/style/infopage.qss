#InfoPage {
    background: #ffffff;
}

#nameLb {
    color: #1a1a1a;
}

#sectionTitleLb {
    color: #b2b2b2;
    margin-left: 30px;
    margin-right: 30px;
}

#remarkTitleLb,
#labelTitleLb {
    color: #8a8a8a;
}

/* 只读态：无边框透明底，看起来与纯文本一致 */
#remarkEdit,
#labelEdit {
    background: transparent;
    border: none;
    border-radius: 4px;
    color: #1a1a1a;
    padding: 2px 4px;
}

/* 获得焦点：浅边框 + 白底，提示当前正在输入 */
#remarkEdit:focus,
#labelEdit:focus {
    background: #ffffff;
    border: 1px solid #d9d9d9;
    padding: 1px 3px;
}

#line1,
#line2 {
    background: #ededed;
    margin-left: 30px;
    margin-right: 30px;
    max-height: 1px;
}

#msgBtn,
#voiceBtn,
#videoBtn {
    color: #595959;
}
