/* ========== InfoPage 个人资料页 ========== */
#InfoPage {
    background: #ffffff;
}

#nameLb {
    color: #1e293b;
    font: bold 18px "Microsoft YaHei";
}

#sectionTitleLb {
    color: #94a3b8;
    font: 12px "Microsoft YaHei";
    margin-left: 30px;
    margin-right: 30px;
}

#remarkTitleLb,
#labelTitleLb {
    color: #64748b;
    font: 13px "Microsoft YaHei";
}

/* 只读态：无边框透明底，看起来与纯文本一致 */
#remarkEdit,
#labelEdit {
    background: transparent;
    border: none;
    border-radius: 4px;
    color: #1e293b;
    font: 14px "Microsoft YaHei";
    padding: 2px 4px;
}

/* 获得焦点：浅边框 + 白底，提示当前正在输入 */
#remarkEdit:focus,
#labelEdit:focus {
    background: #ffffff;
    border: 1px solid #3b82f6;
    padding: 1px 3px;
}

#line1,
#line2 {
    background: #e2e8f0;
    margin-left: 30px;
    margin-right: 30px;
    max-height: 1px;
}

/* ========== 操作按钮：图标按钮带 hover 反馈 ========== */
#msgBtn,
#voiceBtn,
#videoBtn {
    color: #475569;
    border: none;
    border-radius: 6px;
    background: transparent;
    padding: 4px 8px;
}

#msgBtn:hover,
#voiceBtn:hover,
#videoBtn:hover {
    color: #3b82f6;
    background-color: #f1f5f9;
}

#msgBtn:pressed,
#voiceBtn:pressed,
#videoBtn:pressed {
    color: #1d4ed8;
    background-color: #e2e8f0;
}
